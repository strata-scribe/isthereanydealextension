{
  "manifest_version": 3,
  "name": "ITAD GeForce Now Integration",
  "version": "1.0.0",
  "description": "Adds GeForce Now compatibility information to IsThereAnyDeal.com",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://isthereanydeal.com/*",
        "https://store.steampowered.com/app/*"
      ],
      "js": [
        "src/content/index.tsx"
      ]
    }
  ]
}